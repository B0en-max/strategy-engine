# 环境变量示例：复制成 .env 或直接在系统里设置后按需填写。
# 真实密钥**不要**提交到 Git（.gitignore 已忽略 .env 与 .env.*）。

# 行情数据源 API 地址（可选；不设置时使用内置的新浪财经公开地址）
# 新浪财经 K 线接口（Stage 12 已接入，无需认证）：
STRATEGY_ENGINE_DATA_SOURCE_URL=https://money.finance.sina.com.cn/quotes_service/api/json_v2.php/CN_MarketData.getKLineData

# 认证密钥（可选；新浪财经不需要密钥；通过请求头发送，不会出现在 URL 与错误信息里）
# STRATEGY_ENGINE_DATA_SOURCE_API_KEY=your-api-key-here

# 请求超时秒数（可选，默认 10）
STRATEGY_ENGINE_DATA_SOURCE_TIMEOUT=10
