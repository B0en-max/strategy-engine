# 环境变量示例：复制成 .env 或直接在系统里设置后按需填写。
# 真实密钥**不要**提交到 Git（.gitignore 已忽略 .env 与 .env.*）。

# 行情数据源 API 地址（必填）
STRATEGY_ENGINE_DATA_SOURCE_URL=https://api.example.com/v1/klines

# 认证密钥（可选；通过请求头发送，不会出现在 URL 与错误信息里）
STRATEGY_ENGINE_DATA_SOURCE_API_KEY=your-api-key-here

# 请求超时秒数（可选，默认 10）
STRATEGY_ENGINE_DATA_SOURCE_TIMEOUT=10
